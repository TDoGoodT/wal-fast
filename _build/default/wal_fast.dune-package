(lang dune 3.22)
(name wal_fast)
(sections (lib .) (libexec .) (bin ../../bin) (doc ../../doc/wal_fast))
(files
 (lib
  (META
   dune-package
   opam
   wal_ast.ml
   wal_env.ml
   wal_eval.ml
   wal_fast.a
   wal_fast.cma
   wal_fast.cmi
   wal_fast.cmt
   wal_fast.cmx
   wal_fast.cmxa
   wal_fast.ml
   wal_fast__Wal_ast.cmi
   wal_fast__Wal_ast.cmt
   wal_fast__Wal_ast.cmx
   wal_fast__Wal_env.cmi
   wal_fast__Wal_env.cmt
   wal_fast__Wal_env.cmx
   wal_fast__Wal_eval.cmi
   wal_fast__Wal_eval.cmt
   wal_fast__Wal_eval.cmx
   wal_fast__Wal_reader.cmi
   wal_fast__Wal_reader.cmt
   wal_fast__Wal_reader.cmx
   wal_fast__Wal_trace.cmi
   wal_fast__Wal_trace.cmt
